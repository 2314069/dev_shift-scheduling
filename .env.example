# =====================================================
# シフトすけっと 環境変数テンプレート
# コピーして .env.local に名前を変えてから使用してください
# .env.local は .gitignore 済みのため git には入りません
# =====================================================

# --- Auth.js v5 ---
# openssl rand -base64 32 で生成した値を設定してください
AUTH_SECRET=your-auth-secret-here

# --- バックエンド内部認証（Worker サブタスク 2 で導入済）---
# Next.js の HTTP Adapter から FastAPI 内部 API を叩く際に使用
# バックエンドの INTERNAL_AUTH_SECRET と同じ値を設定してください
INTERNAL_AUTH_SECRET=your-internal-auth-secret-here

# --- メール送信（開発環境: Mailpit）---
# docker compose up -d mailpit でローカル SMTP キャプチャを起動してください
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_FROM=noreply@shift-suketto.local

# --- Next.js ---
NEXTAUTH_URL=http://localhost:3000

# --- バックエンド ---
# Auth.js HTTP Adapter が内部 API を叩く際のベース URL
BACKEND_INTERNAL_URL=http://localhost:8000

# --- フロントエンド公開設定 ---
NEXT_PUBLIC_API_URL=http://localhost:8000
